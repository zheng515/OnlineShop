# Copy to .env and fill in. Never commit .env (FR70).
# Use letters and digits only, or URL-encode the password: it is placed in a database URL.
POSTGRES_PASSWORD=change-me
# Host port for the application.
SHOP_PORT=8000
# IP address of your HTTPS reverse proxy (its X-Forwarded-For header is trusted).
FORWARDED_ALLOW_IPS=127.0.0.1
# Address of the shop as customers reach it; used in links in emails.
SHOP_PUBLIC_URL=https://shop.example.com
# Email: "file" (written to the mail volume, not sent) or "smtp".
SHOP_EMAIL_BACKEND=file
SHOP_EMAIL_FROM=OnlineShop <no-reply@shop.example.com>
SHOP_SMTP_HOST=smtp.example.com
SHOP_SMTP_PORT=587
SHOP_SMTP_USERNAME=
SHOP_SMTP_PASSWORD=
# starttls, ssl or none
SHOP_SMTP_SECURITY=starttls

# Countries the shop delivers to, comma-separated (FR102).
SHOP_DELIVERY_COUNTRIES=United States
